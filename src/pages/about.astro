---
import BaseHead from '../components/BaseHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
	<BaseLayout>
		<div class="about">
			<h1 style="margin-top: 0px; margin-bottom: 0px;">About me</h1>
			<p>Hi, I'm Justyn. I'm a 3D artist that specialized in hard surface modelling. Though on some projects I'm a bit of a 3D generalist. I mostly focus on stylized texturing for my work but occasionally I do work with photorealistic textures.</p>
			<p>For business inquiries or just for general questions. Contact me via email at <a href="mailto:contactjustyn@gmail.com" title="E-mail">contactjustyn@gmail.com</a>.</p>
			<div class="row">
				<div class="column">
					<h1 style="margin-top: 0px; margin-bottom: 0px;">Skills</h1>
					<ul style="margin: 10px;">
						<li>3D modelling</li>
						<li>High and Low Poly modelling</li>
						<li>UV mapping</li>
						<li>Texturing</li>
						<li>PBR texturing</li>
						<li>Animation</li>
					</ul>
				</div>
				<div class="column">
					<h1 style="margin-top: 0px; margin-bottom: 0px;">Software</h1>
					<ul style="margin: 10px;">
						<li>Photoshop</li>
						<li>Blender</li>
						<li>Substance Painter</li>
						<li>Source 1 and 2</li>
						<li>Unreal Engine</li>
						<li>Unity</li>
						<li>Github</li>
					</ul>
				</div>
			</div>
			<h1 style="margin-top: 0px; margin-bottom: 0px;">Projects</h1>
				<p style="margin: 10px;"><b><a href="https://medic.tf/">Meet The Real Medic</a></b> (2025-Present)</p>
				<ul style="margin: 0px;">
					<li>Designed, modelled, and textured the Meet The Real Medic logo</li>
					<li>Created additional assets and renders for the <a href="https://medic.tf/">Meet The Real Medic website</a></li>
				</ul>
			<h2 style="margin-top: 10px; margin-bottom: 0px;">Volunteer Projects</h2>
				<p style="margin: 10px;"><b><a href="https://prefortress.com/">Pre-Fortress 2</a></b> (2022-2026)</p>
				<ul style="margin: 0px;">
					<li>Modelled and textured various environment and weapon assets</li>
					<li>Created particle effects for weapons, grenades, environments, and player status effects</li>
					<li>Created a few first person animations and assisted with implementing animations in the Source Engine</li>
					<li>Assisted with optimizing models and materials</li>
					<li>Worked with project leads to improve aspects of the existing asset pipeline as well organized the game's art assets and sources</li>
				</ul>
				<p style="margin: 10px;"><b><a href="https://www.pcgamer.com/if-valve-wont-remake-team-fortress-2-these-modders-will/">Team Fortress: Source 2</a></b> (2021-2024)</p>
				<ul style="margin: 0px;">
					<li>Modelled and textured various weapon and environment assets</li>
					<li>Created various particle effects for weapons and environments</li>
					<li>Assisted with lighting and post processing for environments</li>
				</ul>
			</div>
	</BaseLayout>
	</body>
</html>