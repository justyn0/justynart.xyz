---
import BaseHead from '../../components/BaseHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import type {GetStaticPathsOptions} from "astro";

export async function getStaticPaths({paginate}: GetStaticPathsOptions){
	const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

  	return paginate(posts, { pageSize: 6 });
	// Test paginate
	//return paginate(posts, { pageSize: 1 });
}

// All paginated data is passed on the "page" prop
const { page } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<BaseLayout>
			<div class="home">
				<div class="container">
					{page.data.map((post) => (
					<a href={`/blog/${post.id}/`}>
						<div class="content">
							<img width={100} height={100} src={post.data.heroImage} alt="" />
							<div class="text-content">
								<h2 class="title" style="">{post.data.title}</h2>
								<div class="date" style=""> <FormattedDate date={post.data.pubDate} /></div>
								<p>{post.data.description}</p>
							</div>
						</div>
					</a>))}
					<!-- <div class="pagination"> -->
						<!-- <h4>Page {page.currentPage}</h4> -->
						<!-- {page.url.first ? <a href={page.url.first}>First</a> : null} -->
						<!-- {page.url.prev ? <a href={page.url.prev} class="button">Back</a> : null} -->
						<!-- {page.url.next ? <a href={page.url.next} class="button">Next</a> : null} -->
						<!-- {page.url.last ? <a href={page.url.last}>Last</a> : null} -->
					<!-- </div> -->
				</div>
			</div>
		</BaseLayout>
	</body>
</html>
